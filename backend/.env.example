DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=90
LLM_CONCURRENCY=4
# Search intent only: read timeout and output cap; failure uses local query rules.
QUERY_INTENT_TIMEOUT=15
QUERY_INTENT_MAX_TOKENS=1024
# Ingestion only: shorter index descriptions, original evidence stays intact.
INGEST_PROMPT_PROFILE=compact
INGEST_MAX_TOKENS=4096
# Extraction only: auto disables thinking for DeepSeek V4/flash; other models stay unchanged.
# Use enabled to opt in, or disabled for compatible providers that accept the thinking field.
INGEST_THINKING=auto
# Stop an active SSE request that keeps streaming for too long (including reasoning).
INGEST_REQUEST_TIMEOUT=90
# Stop a streaming request if reasoning has not produced any answer within 45s.
INGEST_FIRST_CONTENT_TIMEOUT=45
# One automatic retry for transient failures, with 2s backoff (maximum allowed: 3).
INGEST_RETRIES=1
# Batch original chunks for extraction; citations and the search index stay per chunk.
INGEST_BATCH_CHARS=3000
INGEST_BATCH_SIZE=6
# Per DOCX/Excel/PDF/PPTX file; a timed-out conversion worker is terminated.
DOCUMENT_CONVERSION_TIMEOUT=120
# Parse in parallel; SQLite index writes remain serial. Set 1 for low-memory hosts.
DOCUMENT_CONVERSION_CONCURRENCY=2

# In-service maintenance, Windows/Linux. All paths should be absolute in deployment.
MAINTENANCE_ENABLED=true
# Hour in Django TIME_ZONE (Asia/Shanghai); missed runs execute on service startup.
MAINTENANCE_HOUR=2
LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
# Defaults: backend/logs/retained and backend/backups/retention.
# Set the backup directory to a separate company disk/mounted share when available.
# RETAINED_LOG_DIR=
# MAINTENANCE_BACKUP_DIR=

# Legacy DOC only: install LibreOffice; auto-detected from PATH or standard Windows install.
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
